{
  "name": "magicbook-registry",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Magicbook registry — vsix 统一管理与分发: 扫描 vsix/ → 生成 metadata → HTTPS 静态分发（kt-ext 协议）",
  "main": null,
  "scripts": {
    "dev": "node --experimental-strip-types --watch src/server.ts",
    "build": "node --experimental-strip-types src/build.ts",
    "serve": "node --experimental-strip-types src/server.ts",
    "start": "node --experimental-strip-types src/build.ts && node --experimental-strip-types src/server.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "adm-zip": "^0.5.12"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.5",
    "@types/node": "^22.0.0",
    "typescript": "^5.5.4"
  }
}