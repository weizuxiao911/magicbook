{
  "name": "magicbook-fs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Magicbook fs 服务（:24097）— 文件系统 API（与 opencode 共享同一 cwd）, 生命周期由 sandbox 管理; 未来容器化内置沙箱容器",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}