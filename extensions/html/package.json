{
  "name": "html",
  "displayName": "HTML Preview",
  "description": "HTML 文件预览（customEditor + webview 渲染）",
  "version": "0.1.0",
  "publisher": "weizuxiao911",
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "browser": "./dist/extension.js",
  "activationEvents": [
    "*"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "htmlPreview",
        "displayName": "HTML Preview",
        "selector": [
          {
            "filenamePattern": "*.html"
          }
        ],
        "priority": "default"
      }
    ],
    "languages": [
      {
        "id": "html",
        "extensions": [
          ".html"
        ],
        "aliases": [
          "HTML Preview"
        ]
      }
    ],
    "commands": [
      {
        "command": "htmlPreview.show",
        "title": "HTML: 预览当前文件"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p .",
    "compile:bundle": "node esbuild.config.mjs",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && npm run compile:bundle",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.75.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.5.4"
  }
}