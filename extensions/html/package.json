{
  "name": "html",
  "displayName": "HTML Viewer",
  "description": "HTML 预览/编辑 (vscode customEditor + webview iframe srcDoc 渲染, tab 菜单栏含编辑/刷新; 切到 vscode 编辑器改 HTML, 改动自动同步回 webview)",
  "version": "0.1.0",
  "publisher": "weizuxiao911",
  "engines": {
    "vscode": "^1.95.0",
    "opensumi": "^3.0.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCustomEditor:htmlViewer",
    "onCommand:html.open",
    "onCommand:html.refresh",
    "onCommand:html.edit"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "htmlViewer",
        "displayName": "HTML Viewer",
        "selector": [
          {
            "filenamePattern": "*.html"
          },
          {
            "filenamePattern": "*.htm"
          }
        ],
        "priority": "default"
      }
    ],
    "languages": [
      {
        "id": "html",
        "extensions": [
          ".html",
          ".htm"
        ],
        "aliases": [
          "HTML"
        ]
      }
    ],
    "commands": [
      {
        "command": "html.open",
        "title": "Open HTML",
        "category": "HTML"
      },
      {
        "command": "html.refresh",
        "title": "刷新",
        "category": "HTML",
        "icon": "$(refresh)"
      },
      {
        "command": "html.edit",
        "title": "编辑",
        "category": "HTML",
        "icon": "$(edit)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "html.refresh",
          "when": "resourceExtname == .html || resourceExtname == .htm",
          "group": "navigation"
        },
        {
          "command": "html.edit",
          "when": "resourceExtname == .html || resourceExtname == .htm",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "compile:bundle": "node esbuild.config.mjs",
    "build": "npm run clean && npm run compile:bundle",
    "package": "npm run build && node scripts/package.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/vscode": "^1.75.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.5.4"
  },
  "browser": "./dist/extension.js",
  "license": "MIT"
}
