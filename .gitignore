# 依赖
node_modules/

# 构建产物
dist/
out/
*.vsix
.webpack-cache/

# 环境配置（仅 .env.example 提交到 git，其它 gitignore）
.env
.env.local
.env.*.local
.env.development
.env.staging
.env.production
client/.env
client/.env.local
client/.env.*.local
client/.env.development
client/.env.staging
client/.env.production

# 运行时工作区/数据
/workspace/
/data/

# server 拓展源码（server/extensions/<name>/ 入库）; 分发存储产物归 registry（registry/.gitignore）

# 临时
.cache/
*.log
.logs/
.tmp/

# 编辑器/系统
.DS_Store
.idea/
.vscode/
.playwright-mcp/
.userData/registry/certs/
