{
  "name": "workspace",
  "version": "0.1.0",
  "private": true,
  "description": "基于 codeblitz + opencode 构建的 AI 工作台",
  "scripts": {
    "dev": "concurrently -k -n sandbox,client -c blue,green \"npm:dev:sandbox\" \"npm:dev:client\"",
    "dev:sandbox": "npm --prefix sandbox run dev",
    "dev:client": "npm --prefix client run dev"
  },
  "devDependencies": {
    "concurrently": "^10.0.4",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "cross-env": "^7.0.3",
    "css-loader": "^6.7.3",
    "file-loader": "^6.2.0",
    "html-webpack-plugin": "^5.6.0",
    "less": "^4.8.1",
    "less-loader": "^12.3.3",
    "node-polyfill-webpack-plugin": "^3.0.0",
    "path-browserify": "^1.0.1",
    "raw-loader": "^4.0.2",
    "style-loader": "^3.3.1",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4",
    "url-loader": "^4.1.1",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1"
  }
}