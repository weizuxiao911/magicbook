### Variables 
@host = http://127.0.0.1:4096
@dir = /Users/weizuxiao/Documents/opencode
@sessionID = ses_xxx
@messageID = msg_xxx
@credentialID = cred_xxx
@ptyID = pty_xxx
@providerID = prj_xxx
@integrationID = intg_xxx
@attemptID = att_xxx
@permissionID = perm_xxx
@questionID = qst_xxx
@directory = {{dir}}

# ============================================================
# Health
# ============================================================

### health.get
GET {{host}}/api/health

# ============================================================
# Location
# ============================================================

### location.get
GET {{host}}/api/location?location[directory]={{directory}}

# ============================================================
# Filesystem
# ============================================================

### fs.stat
GET {{host}}/api/fs/stat?path=README.md&location[directory]={{directory}}

### fs.list
GET {{host}}/api/fs/list?location[directory]={{directory}}

### fs.find
GET {{host}}/api/fs/find?query=README&location[directory]={{directory}}

### fs.read
GET {{host}}/api/fs/read/README.md?location[directory]={{directory}}

### fs.write
POST {{host}}/api/fs/write?location[directory]={{directory}}
Content-Type: application/json

{
  "path": "test-write.txt",
  "content": "aGVsbG8gd29ybGQ="
}

### fs.mkdir
POST {{host}}/api/fs/mkdir?location[directory]={{directory}}
Content-Type: application/json

{
  "path": "test-dir/nested",
  "recursive": true
}

### fs.rename
POST {{host}}/api/fs/rename?location[directory]={{directory}}
Content-Type: application/json

{
  "from": "test-write.txt",
  "to": "test-dir/moved.txt"
}

### fs.remove
POST {{host}}/api/fs/remove?location[directory]={{directory}}
Content-Type: application/json

{
  "path": "test-dir/moved.txt",
  "recursive": true
}

### fs.watch (SSE)
GET {{host}}/api/fs/watch?location[directory]={{directory}}

# ============================================================
# Session
# ============================================================

### session.list
GET {{host}}/api/session

### session.create
POST {{host}}/api/session
Content-Type: application/json

{}

### session.active
GET {{host}}/api/session/active

### session.get
GET {{host}}/api/session/{{sessionID}}

### session.switchAgent
POST {{host}}/api/session/{{sessionID}}/agent
Content-Type: application/json

{
  "agent": "build"
}

### session.switchModel
POST {{host}}/api/session/{{sessionID}}/model
Content-Type: application/json

{
  "providerID": "{{providerID}}",
  "modelID": "claude-sonnet"
}

### session.prompt
POST {{host}}/api/session/{{sessionID}}/prompt
Content-Type: application/json

{
  "parts": [
    { "type": "text", "text": "hello" }
  ]
}

### session.compact
POST {{host}}/api/session/{{sessionID}}/compact
Content-Type: application/json

{}

### session.wait
POST {{host}}/api/session/{{sessionID}}/wait
Content-Type: application/json

{}

### session.revert.stage
POST {{host}}/api/session/{{sessionID}}/revert/stage
Content-Type: application/json

{}

### session.revert.clear
POST {{host}}/api/session/{{sessionID}}/revert/clear
Content-Type: application/json

{}

### session.revert.commit
POST {{host}}/api/session/{{sessionID}}/revert/commit
Content-Type: application/json

{}

### session.context
GET {{host}}/api/session/{{sessionID}}/context

### session.history
GET {{host}}/api/session/{{sessionID}}/history

### session.events
GET {{host}}/api/session/{{sessionID}}/event

### session.interrupt
POST {{host}}/api/session/{{sessionID}}/interrupt
Content-Type: application/json

{}

### session.message
GET {{host}}/api/session/{{sessionID}}/message/{{messageID}}

